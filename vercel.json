{
  "functions": {
    "api/contact.js": { "maxDuration": 10 },
    "api/events.js":  { "maxDuration": 10 }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "midwestairsoft.space" }],
